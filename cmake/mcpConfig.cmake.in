@PACKAGE_INIT@

# The exported mcp target references platform thread libraries (propagated as
# INTERFACE because httplib is linked only through BUILD_INTERFACE). Resolve
# that imported target before loading mcpTargets.cmake.
include(CMakeFindDependencyMacro)
if(UNIX)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mcpTargets.cmake")
check_required_components(mcp)
