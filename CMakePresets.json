{
    "version": 3,
    "configurePresets": [
        {
            "name": "msys2-base",
            "description": "msys2-clang64 toolchain, Ninja, Windows x64.",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "D:/msys64/clang64/bin/ninja.exe",
                "CMAKE_C_COMPILER": "D:/msys64/clang64/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "D:/msys64/clang64/bin/clang++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-dbg",
            "displayName": "clang Debug",
            "inherits": "msys2-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-rlz",
            "displayName": "clang Release",
            "inherits": "msys2-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ]
}
